{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x-thread-saver",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE_MEDIA",
      "bucket_name": "x-thread-saver-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-thread-saver-db",
      "migrations_dir": "./migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ARCHIVE_QUEUE",
        "queue": "x-thread-saver-queue"
      }
    ],
    "consumers": [
      {
        "queue": "x-thread-saver-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
